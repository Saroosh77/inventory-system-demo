# Copy to .env and fill in. Every variable below is read by the application,
# by docker-compose, or by both.
#
# These are demo values. The data this system holds is entirely fictional, but
# the credentials below are still real credentials — change them before putting
# the demo anywhere reachable from the internet.

# --- Database (docker-compose creates the container from these) ---
POSTGRES_DB="inventory_demo"
POSTGRES_USER="demo"
POSTGRES_PASSWORD="change-me-before-deploying"
# Host port for the database. Containers always talk to database:5432 internally.
POSTGRES_HOST_PORT="5440"

# Connection string used by Prisma. Inside Docker the app overrides this to
# point at the database service; set it to localhost for local development.
DATABASE_URL="postgresql://demo:change-me-before-deploying@localhost:5440/inventory_demo?schema=public"
DIRECT_URL="postgresql://demo:change-me-before-deploying@localhost:5440/inventory_demo?schema=public"

# --- Application ---
NODE_ENV="development"
APP_PORT="3000"
APP_HOST_PORT="3000"

# --- Demo branding (shown in the sidebar) ---
NEXT_PUBLIC_COMPANY_NAME="Demo Distribution System"
NEXT_PUBLIC_COMPANY_TAGLINE="Distribution — demo data"

# --- Demo logins ---
# Assigned to admin@demo.local, finance@demo.local and warehouse@demo.local by
# `npm run db:seed`.
DEMO_USER_PASSWORD="DemoPass!2026"
# Shown on the sign-in screen as one-click role shortcuts. Set
# NEXT_PUBLIC_SHOW_DEMO_LOGINS to "false" to hide them entirely.
NEXT_PUBLIC_DEMO_PASSWORD="DemoPass!2026"
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"

# --- Initial administrator (bootstrapped on first start, seed aside) ---
# An existing password hash is never overwritten by this value.
INITIAL_ADMIN_EMAIL="admin@demo.local"
INITIAL_ADMIN_NAME="Demo Administrator"
INITIAL_ADMIN_PASSWORD="DemoPass!2026"

# --- Optional ---
# How far back a transaction may be dated, in days. Documents older than this
# are rejected so entries cannot land in periods already reported on.
POSTING_BACKDATE_LIMIT_DAYS="90"

# debug | info | warn | error. Defaults to info in production, debug otherwise.
LOG_LEVEL="debug"
